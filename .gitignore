# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Local pip install directory (not needed by other users)
lib/

# Database files (generated — do not commit)
*.db
data/output/
data/processed/
data/raw/

# Reports (generated at runtime)
reports/*
!reports/.gitkeep

# Quarantine (generated at runtime)
data/quarantine/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
.env
*.pem

# pytest cache
.pytest_cache/
